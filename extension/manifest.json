{
  "manifest_version": 3,
  "name": "Bewpakorn Queue",
  "version": "1.5.0",
  "description": "คิวออเดอร์แมพสำหรับ Bewpakorn",
  "permissions": [
    "sidePanel",
    "storage",
    "nativeMessaging",
    "notifications",
    "tabs",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "https://bewpakorn.rdcw.xyz/*",
    "https://roblox.com/*",
    "https://*.roblox.com/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "เปิด Bewpakorn Queue"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "options.html",
  "key": ""
}
